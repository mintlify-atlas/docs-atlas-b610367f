  "keyFeatures": [
    "Reading room and seat management with real-time availability status",
    "Seat reservation workflow with check-in and check-out",
    "Face recognition-powered check-in and check-out via Baidu AI API",
    "Violation reporting system with credit score deductions",
    "JWT authentication with RSA-encrypted passwords and CAPTCHA login",
    "Role-based access control with fine-grained permission checks",
    "Redis-backed online user session management",
    "Book catalog management",
    "Code generator module for rapid CRUD scaffolding",
    "Excel data export for all entities"
  ],
